# 이 파일을 .env로 복사해서 사용한다:  cp .env.example .env
# 아래 기본값은 docker-compose.yml(로컬 Postgres + Mailpit)에 맞춰져 있다.

DATABASE_URL="postgresql://ubuntu:ubuntu@localhost:5432/ubuntubooks?schema=public"

# Auth.js (v5)
AUTH_SECRET=""            # JWT 암호화 키. npx auth secret 으로 생성
AUTH_URL="http://localhost:3000"

# 네이버 Callback URL: {AUTH_URL}/api/auth/callback/naver
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# TODO(kakao): 카카오 provider 활성화 시 사용
# AUTH_KAKAO_ID=""
# AUTH_KAKAO_SECRET=""

# 이메일 매직 링크 발송 (SMTP)
# 로컬: Mailpit이 메일을 가로채 http://localhost:8025 에 보여준다 (실제 발송 안 됨)
# 운영: 실제 SMTP로 교체. 형식 smtp://아이디:비밀번호@서버:포트 (특수문자는 URL 인코딩, 예: @ → %40)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="우분투북스 <no-reply@ubuntubooks.local>"

# Toss Payments
TOSS_PAYMENTS_SECRET_KEY="test_sk_..."
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY="test_ck_..."
