# 이 파일을 .env로 복사해서 사용한다:  cp .env.example .env
# 네이버 로그인 로컬 테스트에 필요한 값은 AUTH_SECRET, AUTH_NAVER_ID, AUTH_NAVER_SECRET 3개다.

# Auth.js (v5)
AUTH_SECRET=""            # JWT 암호화 키. npx auth secret 으로 생성
AUTH_URL="http://localhost:3000"

# 네이버 개발자센터 > 애플리케이션 > API 설정
#   서비스 URL:  http://localhost:3000
#   Callback URL: http://localhost:3000/api/auth/callback/naver
#   제공 정보: 이메일(필수), 이름
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# TODO(db): 임시 관리자(점주) 이메일 목록. 쉼표로 구분. DB User.role을 쓰게 되면 삭제
ADMIN_EMAILS=""

